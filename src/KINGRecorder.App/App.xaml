<Application
    x:Class="KINGRecorder.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Premium KING Design System Palette -->
            <SolidColorBrush x:Key="KingBlack" Color="#0C0D10" />
            <SolidColorBrush x:Key="KingCharcoal" Color="#15171E" />
            <SolidColorBrush x:Key="KingGold" Color="#D4AF37" />
            <SolidColorBrush x:Key="KingRecordingRed" Color="#EF4444" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
