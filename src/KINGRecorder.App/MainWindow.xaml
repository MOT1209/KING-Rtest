<Window
    x:Class="KINGRecorder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="KING RECORDER — Professional Screen Recording Studio">

    <Grid Background="{StaticResource KingBlack}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Mica Titlebar -->
        <Border Grid.Row="0" x:Name="AppTitleBar" Height="48" Background="{StaticResource KingCharcoal}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="👑 KING RECORDER" Foreground="{StaticResource KingGold}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="1.0 MVP (Phase 0.1.1 Stabilized Foundation)" Margin="12,0,0,0" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Studio Viewport -->
        <Grid Grid.Row="1" Margin="24">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                <TextBlock Text="KING RECORDER Native WinUI 3 Foundation Stabilized" Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Screen Capture: Not Implemented • Audio: Not Implemented • Video Encoder: Not Implemented" Foreground="#D4AF37" FontSize="12" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Truthful Status Bar -->
        <Border Grid.Row="2" Height="32" Background="#0A0B0E" BorderBrush="#222530" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text=".NET 10 LTS • WinUI 3 + Windows App SDK 1.5 • Architecture Initialized &amp; Verified" Foreground="#888888" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
