<Window
    x:Class="KINGRecorder.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="KING RECORDER — Professional Screen Recording Studio">

    <Grid Background="{StaticResource KingBlack}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom Mica Titlebar -->
        <Border Grid.Row="0" x:Name="AppTitleBar" Height="48" Background="{StaticResource KingCharcoal}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="👑 KING RECORDER" Foreground="{StaticResource KingGold}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                <TextBlock Text="1.0 MVP" Margin="12,0,0,0" Foreground="#888888" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Main Studio Viewport -->
        <Grid Grid.Row="1" Margin="24">
            <TextBlock Text="KING RECORDER Native Studio Engine Initialized" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Height="32" Background="#0A0B0E" BorderBrush="#222530" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                <TextBlock Text="Direct3D 11 Active • WASAPI 48kHz • H.264 Hardware Encoder" Foreground="#888888" FontSize="11"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
